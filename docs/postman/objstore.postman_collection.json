{
  "info": {
    "name": "objstore",
    "description": "API S3 dan API admin objstore.\n\nAutentikasi memakai AWS Signature (SigV4) di level collection, service `s3`. Isi variabel\n`accessKey` dan `secretKey` (kredensial root dari OBJSTORE_ACCESS_KEY/OBJSTORE_SECRET_KEY, atau token)\ndi environment Postman atau di kolom Current value, supaya secret tidak ikut tersimpan saat collection diekspor.\n\nUntuk kredensial sementara, isi juga `sessionToken`.\n\nFolder disusun supaya bisa dijalankan berurutan (Run collection) di server kosong; Cleanup menghapus bucket contoh di akhir.\nRequest yang membuat token atau multipart upload menyimpan id-nya ke variabel collection secara otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "awsv4",
    "awsv4": [
      {
        "key": "accessKey",
        "value": "{{accessKey}}",
        "type": "string"
      },
      {
        "key": "secretKey",
        "value": "{{secretKey}}",
        "type": "string"
      },
      {
        "key": "region",
        "value": "{{region}}",
        "type": "string"
      },
      {
        "key": "service",
        "value": "s3",
        "type": "string"
      },
      {
        "key": "sessionToken",
        "value": "{{sessionToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000"
    },
    {
      "key": "region",
      "value": "us-east-1"
    },
    {
      "key": "accessKey",
      "value": ""
    },
    {
      "key": "secretKey",
      "value": ""
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "bucket",
      "value": "contoh-bucket"
    },
    {
      "key": "key",
      "value": "folder/halo.txt"
    },
    {
      "key": "copyKey",
      "value": "folder/halo-salinan.txt"
    },
    {
      "key": "tokenId",
      "value": ""
    },
    {
      "key": "uploadId",
      "value": ""
    },
    {
      "key": "partEtag",
      "value": ""
    }
  ],
