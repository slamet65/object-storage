              ],
              "path": [
                "{{bucket}}"
              ],
              "query": [
                {
                  "key": "cors",
                  "value": null
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete bucket CORS",
          "request": {
            "method": "DELETE",
            "header": [],
