    {
      "name": "S3 - Objects",
      "description": "",
      "item": [
        {
          "name": "Put object",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              },
              {
                "key": "x-amz-meta-penulis",
                "value": "postman"
              },
              {
                "key": "x-amz-storage-class",
                "value": "STANDARD"
              },
              {
                "key": "If-None-Match",
                "value": "*",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "Halo dari Postman!"
            },
            "description": "Untuk upload file, ganti body ke binary. Aktifkan If-None-Match: * supaya gagal kalau object sudah ada."
          },
          "response": []
        },
        {
          "name": "Head object",
          "request": {
            "method": "HEAD",
            "header": [
              {
                "key": "x-amz-checksum-mode",
                "value": "ENABLED"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get object",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-99",
                "disabled": true
              },
              {
                "key": "If-None-Match",
                "value": "\"etag\"",
                "disabled": true
              },
              {
                "key": "x-amz-checksum-mode",
                "value": "ENABLED",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Copy object",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-amz-copy-source",
                "value": "/{{bucket}}/{{key}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{copyKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{copyKey}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete object",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete objects (batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}?delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}"
              ],
              "query": [
                {
                  "key": "delete",
                  "value": null
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<Delete xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <Object><Key>{{key}}</Key></Object>\n  <Object><Key>{{copyKey}}</Key></Object>\n  <Quiet>false</Quiet>\n</Delete>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "S3 - Multipart",
      "description": "Jalankan berurutan. Semua part kecuali yang terakhir minimal 5 MiB, jadi contoh ini memakai satu part saja.",
      "item": [
        {
          "name": "Create multipart upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}?uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ],
              "query": [
                {
                  "key": "uploads",
                  "value": null
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.text().match(/<UploadId>([^<]+)<\\/UploadId>/);",
                  "if (m) pm.collectionVariables.set('uploadId', m[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload part",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}?partNumber=1&uploadId={{uploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ],
              "query": [
                {
                  "key": "partNumber",
                  "value": "1"
                },
                {
                  "key": "uploadId",
                  "value": "{{uploadId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "Isi part pertama."
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('partEtag', pm.response.headers.get('ETag') || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "List parts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}?uploadId={{uploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ],
              "query": [
                {
                  "key": "uploadId",
                  "value": "{{uploadId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List multipart uploads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}?uploads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}"
              ],
              "query": [
                {
                  "key": "uploads",
                  "value": null
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Complete multipart upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}?uploadId={{uploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ],
              "query": [
                {
                  "key": "uploadId",
                  "value": "{{uploadId}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<CompleteMultipartUpload xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <Part><PartNumber>1</PartNumber><ETag>{{partEtag}}</ETag></Part>\n</CompleteMultipartUpload>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Abort multipart upload (alternatif Complete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}/{{key}}?uploadId={{uploadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}",
                "{{key}}"
              ],
              "query": [
                {
                  "key": "uploadId",
                  "value": "{{uploadId}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin - Tokens",
      "description": "API JSON di /-/admin/. Membuat dan mengelola token butuh admin-read-write tanpa batasan bucket.",
      "item": [
        {
          "name": "Whoami",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/-/admin/whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "-",
                "admin",
                "whoami"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/-/admin/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "-",
                "admin",
                "tokens"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/-/admin/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "-",
                "admin",
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"aplikasi\",\n  \"permission\": \"object-read-write\",\n  \"buckets\": [\n    \"{{bucket}}\"\n  ],\n  \"ttl_seconds\": 2592000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "permission: object-read, object-read-write, admin-read, admin-read-write. buckets kosong berarti semua bucket. ttl_seconds 0 berarti tanpa kedaluwarsa. Secret hanya muncul di respons ini."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('tokenId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
