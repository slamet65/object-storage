                {
                  "key": "cors",
                  "value": null
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Put bucket lifecycle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}?lifecycle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}"
              ],
              "query": [
                {
                  "key": "lifecycle",
                  "value": null
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<LifecycleConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <Rule>\n    <ID>hapus-tmp</ID>\n    <Status>Enabled</Status>\n    <Filter><Prefix>tmp/</Prefix></Filter>\n    <Expiration><Days>7</Days></Expiration>\n  </Rule>\n  <Rule>\n    <ID>ia-arsip</ID>\n    <Status>Enabled</Status>\n    <Filter><Prefix>arsip/</Prefix></Filter>\n    <Transition><Days>30</Days><StorageClass>STANDARD_IA</StorageClass></Transition>\n  </Rule>\n  <Rule>\n    <ID>bersihkan-multipart</ID>\n    <Status>Enabled</Status>\n    <Filter><Prefix></Prefix></Filter>\n    <AbortIncompleteMultipartUpload><DaysAfterInitiation>3</DaysAfterInitiation></AbortIncompleteMultipartUpload>\n  </Rule>\n</LifecycleConfiguration>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get bucket lifecycle",
