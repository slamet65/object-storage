    {
      "name": "S3 - Bucket config",
      "description": "CORS dan lifecycle; butuh token admin.",
      "item": [
        {
          "name": "Put bucket CORS",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}?cors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bucket}}"
              ],
              "query": [
                {
                  "key": "cors",
                  "value": null
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<CORSConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <CORSRule>\n    <AllowedOrigin>http://localhost:3000</AllowedOrigin>\n    <AllowedMethod>GET</AllowedMethod>\n    <AllowedMethod>PUT</AllowedMethod>\n    <AllowedHeader>*</AllowedHeader>\n    <ExposeHeader>ETag</ExposeHeader>\n    <MaxAgeSeconds>3600</MaxAgeSeconds>\n  </CORSRule>\n</CORSConfiguration>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get bucket CORS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bucket}}?cors",
              "host": [
