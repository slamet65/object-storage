              ],
              "path": [
                "-",
                "admin",
                "temp-credentials"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ttl_seconds\": 3600,\n  \"permission\": \"object-read\",\n  \"buckets\": [\n    \"{{bucket}}\"\n  ],\n  \"prefixes\": [\n    \"folder/\"\n  ],\n  \"objects\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Menerbitkan kredensial sementara dari pemanggil. Izin dan cakupan tidak boleh melebihi milik pemanggil; TTL paling lama 7 hari. Pakai hasilnya di accessKey, secretKey, dan sessionToken."
          },
          "response": []
        }
      ]
    },
